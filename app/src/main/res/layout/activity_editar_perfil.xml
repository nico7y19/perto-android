<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:scrollbars="none" xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/perto_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<ImageButton android:id="@+id/voltar" style="@style/Widget.Perto.Back" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_edit" android:textSize="26sp" android:fontFamily="sans-serif-medium" android:textColor="@color/white" />
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/loading" android:textColor="@color/white" android:accessibilityLiveRegion="polite" />
<TextView android:id="@+id/label_nome" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:labelFor="@+id/nome" android:text="@string/label_name" android:textColor="@color/perto_muted" />
<EditText android:id="@+id/nome" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:background="@drawable/perto_input" android:padding="16dp" android:textColor="@color/white" android:inputType="textPersonName" android:maxLength="120" />
<TextView android:id="@+id/label_endereco" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:labelFor="@+id/endereco" android:text="@string/label_address" android:textColor="@color/perto_muted" />
<EditText android:id="@+id/endereco" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:background="@drawable/perto_input" android:padding="16dp" android:textColor="@color/white" android:inputType="textPostalAddress" android:maxLength="300" />
<TextView android:id="@+id/label_cnpj" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:labelFor="@+id/cnpj" android:text="@string/optional_cnpj" android:textColor="@color/perto_muted" />
<EditText android:id="@+id/cnpj" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:background="@drawable/perto_input" android:padding="16dp" android:textColor="@color/white" android:inputType="text" android:maxLength="18" />
<TextView android:id="@+id/label_telefone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:labelFor="@+id/telefone" android:text="@string/optional_phone" android:textColor="@color/perto_muted" />
<EditText android:id="@+id/telefone" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:background="@drawable/perto_input" android:padding="16dp" android:textColor="@color/white" android:inputType="phone" android:maxLength="20" />
<Button android:id="@+id/salvar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/profile_save" android:enabled="false" />
<Button android:id="@+id/tentar" style="@style/Widget.Perto.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/retry" android:visibility="gone" />

</LinearLayout></ScrollView>
