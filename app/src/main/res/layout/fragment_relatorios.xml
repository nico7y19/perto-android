<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:scrollbars="none" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/perto_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="20dp" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/report_title" android:textSize="26sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:textColor="@color/white" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/report_hint" android:textColor="@color/perto_muted" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:textColor="@color/perto_muted" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/resumo" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:padding="20dp" android:background="@drawable/perto_surface"
            android:textColor="@color/white" android:textSize="18sp" android:lineSpacingExtra="5dp" android:visibility="gone" android:textIsSelectable="true" />
        <Button android:id="@+id/mais" style="@style/Widget.Perto.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/filter_more" android:visibility="gone" />
        <Button android:id="@+id/atualizar" style="@style/Widget.Perto.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/event_refresh" />
    </LinearLayout>
</ScrollView>
