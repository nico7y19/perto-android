<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:scrollbars="none" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/perto_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <ImageButton android:id="@+id/voltar" style="@style/Widget.Perto.Back" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/review_title" android:textSize="26sp" android:fontFamily="sans-serif-medium" android:textColor="@color/white" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:textColor="@color/perto_muted" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/tentar" style="@style/Widget.Perto.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/retry" android:visibility="gone" />
        <LinearLayout android:id="@+id/formulario" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/review_mine" android:textSize="20sp" android:textColor="@color/white" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:labelFor="@+id/nota" android:text="@string/review_score" android:textColor="@color/perto_muted" />
            <Spinner android:id="@+id/nota" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="56dp" android:background="@drawable/perto_input" android:enabled="false" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:labelFor="@+id/comentario" android:text="@string/review_comment" android:textColor="@color/perto_muted" />
            <EditText android:id="@+id/comentario" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="112dp" android:gravity="top|start" android:inputType="textCapSentences|textMultiLine"
                android:padding="16dp" android:background="@drawable/perto_input" android:textColor="@color/white"
                android:maxLength="1000" android:enabled="false" />
            <Button android:id="@+id/salvar" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/review_save" android:enabled="false" />
        </LinearLayout>
        <LinearLayout android:id="@+id/painel_lista" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/review_list" android:textSize="20sp" android:textColor="@color/white" />
            <TextView android:id="@+id/status_lista" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/perto_muted" android:accessibilityLiveRegion="polite" />
            <LinearLayout android:id="@+id/lista" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <Button android:id="@+id/mais" style="@style/Widget.Perto.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/filter_more" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
