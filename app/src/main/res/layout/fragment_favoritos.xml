<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:scrollbars="none" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/perto_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/menu_favoritos"
            android:textColor="@color/white" android:textSize="26sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/favorites_subtitle"
            android:layout_marginTop="8dp" android:textColor="@color/perto_muted" />
        <TextView android:id="@+id/tv_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/loading" android:textColor="@color/white" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/btn_atualizar" style="@style/Widget.Perto.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/event_refresh" />
        <LinearLayout android:id="@+id/lista_eventos" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="16dp" />
        <Button android:id="@+id/btn_mais" style="@style/Widget.Perto.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/favorites_more" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
