<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:scrollbars="none" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/perto_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/event_category" android:textSize="18sp" android:textColor="@color/white" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/filter_categories_hint" android:textColor="@color/perto_muted" />
        <LinearLayout android:id="@+id/categorias" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/event_price_label" android:textSize="18sp" android:textColor="@color/white" />
        <RadioGroup android:id="@+id/precos" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/preco_todos" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/filter_price_all" android:textColor="@color/white" />
            <RadioButton android:id="@+id/preco_gratuitos" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/filter_price_free" android:textColor="@color/white" />
            <RadioButton android:id="@+id/preco_pagos" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/filter_price_paid" android:textColor="@color/white" />
        </RadioGroup>
    </LinearLayout>
</ScrollView>
