<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="12dp" android:background="@drawable/perto_surface" android:padding="16dp" android:orientation="vertical">
    <TextView android:id="@+id/nota" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/perto_accent" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
    <TextView android:id="@+id/comentario" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="@color/white" android:textSize="16sp" android:textIsSelectable="true" />
</LinearLayout>
