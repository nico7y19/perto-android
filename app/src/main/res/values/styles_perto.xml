<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Perto.Interno" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/perto_accent</item>
        <item name="colorPrimaryVariant">@color/perto_accent_soft</item>
        <item name="colorOnPrimary">@color/perto_background</item>
        <item name="colorSecondary">@color/perto_accent</item>
        <item name="colorOnSecondary">@color/perto_background</item>
        <item name="colorSurface">@color/perto_surface</item>
        <item name="colorOnSurface">@color/perto_text</item>
        <item name="colorOnBackground">@color/perto_text</item>
        <item name="android:colorBackground">@color/perto_background</item>
        <item name="android:colorBackgroundFloating">@color/perto_surface</item>
        <item name="android:windowBackground">@color/perto_background</item>
        <item name="android:statusBarColor">@color/perto_background</item>
        <item name="android:navigationBarColor">@color/perto_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:textColorPrimary">@color/perto_text</item>
        <item name="android:textColorSecondary">@color/perto_muted</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="colorControlNormal">@color/perto_muted</item>
        <item name="colorControlActivated">@color/perto_accent</item>
        <item name="materialButtonStyle">@style/Widget.Perto.Button</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Perto.Dialog</item>
    </style>
    <style name="ThemeOverlay.Perto.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/perto_surface</item>
        <item name="colorPrimary">@color/perto_accent</item>
        <item name="android:textColorPrimary">@color/perto_text</item>
        <item name="android:textColorSecondary">@color/perto_muted</item>
        <item name="android:colorBackground">@color/perto_surface</item>
    </style>
    <style name="Widget.Perto.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/perto_accent</item>
        <item name="android:textColor">@color/perto_background</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="Widget.Perto.Button.Secondary" parent="Widget.Perto.Button">
        <item name="backgroundTint">@color/perto_surface</item>
        <item name="android:textColor">@color/perto_accent</item>
        <item name="strokeColor">@color/perto_border</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Shape.Perto.Image" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
    <style name="Widget.Perto.Back" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_gravity">start</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/perto_input</item>
        <item name="android:src">@drawable/ic_arrow_back</item>
        <item name="tint">@color/perto_accent</item>
        <item name="android:contentDescription">@string/event_back</item>
        <item name="android:tooltipText">@string/event_back</item>
    </style>
    <style name="Shape.Perto.Cover" parent="Shape.Perto.Image">
        <item name="cornerSize">24dp</item>
    </style>
    <style name="Widget.Perto.NavIndicator" parent="">
        <item name="android:width">48dp</item>
        <item name="android:height">36dp</item>
        <item name="android:color">@color/perto_accent_soft</item>
        <item name="shapeAppearance">@style/Shape.Perto.Image</item>
    </style>
</resources>
